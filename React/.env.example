# Base URL of the shared REST API. Leave blank only for UI development.
VITE_API_BASE_URL=

# Backend-provided relative path for the login endpoint. Do not guess this value.
VITE_AUTH_LOGIN_PATH=

# Backend-provided relative path for the authenticated dashboard summary. Do not guess this value.
VITE_DASHBOARD_SUMMARY_PATH=

# LOCAL DEVELOPMENT ONLY. Allows a clearly labelled non-production session to exercise routes.
VITE_ENABLE_DEV_SESSION=false
