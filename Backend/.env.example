# Runtime environment for the API foundation.
NODE_ENV=development
PORT=4000

# API namespace. Keep this aligned with the backend foundation unless a future
# approved API contract changes it.
API_PREFIX=/api/v1

# Optional allowed browser origin. Leave blank until approved client origins are known.
CORS_ORIGIN=

# Optional MongoDB connection string. Use a local instance for development or
# provide a deployment-specific Atlas value through the host environment.
MONGODB_URI=mongodb://localhost:27017/salon_saas

# Required before auth endpoints can issue or verify access tokens. Use a long,
# unique value in each deployment environment; never commit the real secret.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
